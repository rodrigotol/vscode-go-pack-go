{
  "name": "go-pack-go",
  "displayName": "Go Pack Go",
  "description": "VS Code Go productivity features for table tests, type implementations, main entrypoints and enhanced find references",
  "version": "0.0.1",
  "publisher": "rodrigotol",
  "license": "SEE LICENSE IN LICENSE.txt",
  "homepage": "https://github.com/rodrigotol/vscode-go-pack-go#readme",
  "bugs": {
    "url": "https://github.com/rodrigotol/vscode-go-pack-go/issues"
  },
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Debuggers"
  ],
  "keywords": [
    "go",
    "golang",
    "codelens",
    "debug",
    "testing",
    "go test",
    "table-driven tests",
    "table tests",
    "subtest",
    "references",
    "read write references",
    "implementation",
    "go to implementation",
    "delve",
    "go debugger",
    "main"
  ],
  "galleryBanner": {
    "color": "#0E4079",
    "theme": "dark"
  },
  "markdown": "github",
  "activationEvents": [
    "onLanguage:go"
  ],
  "extensionDependencies": [
    "golang.go"
  ],
  "contributes": {
    "commands": [
      {
        "command": "go-pack-go.runGoMain",
        "title": "Go Pack Go: Run Go Main"
      },
      {
        "command": "go-pack-go.debugGoMain",
        "title": "Go Pack Go: Debug Go Main"
      },
      {
        "command": "go-pack-go.findReferences",
        "title": "Go to References (Go Pack Go)"
      },
      {
        "command": "go-pack-go.openReference",
        "title": "Open Reference"
      },
      {
        "command": "go-pack-go.toggleWrite",
        "title": "Toggle Write Usages",
        "icon": "$(pencil)"
      },
      {
        "command": "go-pack-go.toggleRead",
        "title": "Toggle Read Usages",
        "icon": "$(eye)"
      },
      {
        "command": "go-pack-go.toggleOther",
        "title": "Toggle Other Usages",
        "icon": "$(symbol-misc)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "go-pack-go",
          "title": "Go Pack Go - References",
          "icon": "$(references)"
        }
      ]
    },
    "views": {
      "go-pack-go": [
        {
          "id": "go-pack-go.referencesView",
          "name": "References",
          "type": "tree"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "go-pack-go.findReferences",
          "when": "editorTextFocus",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "go-pack-go.toggleWrite",
          "when": "view == go-pack-go.referencesView",
          "group": "navigation@1"
        },
        {
          "command": "go-pack-go.toggleRead",
          "when": "view == go-pack-go.referencesView",
          "group": "navigation@2"
        },
        {
          "command": "go-pack-go.toggleOther",
          "when": "view == go-pack-go.referencesView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Go Pack Go",
      "properties": {
        "goPackGo.enableDebugLogs": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose logging for the Go main runner feature."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle:production",
    "compile": "node esbuild.js",
    "bundle:production": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "watch": "node esbuild.js --watch",
    "package": "vsce package --no-dependencies",
    "compile:tests": "tsc -p tsconfig.test.json && node esbuild.js --copy-runtime-assets=out-test",
    "test:unit": "node scripts/run-tests.js",
    "test:extension-host": "npm run package && node scripts/run-extension-host-tests.js",
    "test": "npm run typecheck && npm run compile:tests && npm run test:unit && npm run test:extension-host"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.120.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  },
  "icon": "resources/gophermechanic.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigotol/vscode-go-pack-go.git"
  }
}
